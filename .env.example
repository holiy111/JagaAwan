# Salin file ini menjadi .env lalu isi nilainya
# JANGAN commit file .env ke repository

# URL project Supabase (contoh: https://abcdefghijkl.supabase.co)
SUPABASE_URL=

# Service Role Key Supabase (Dashboard -> Settings -> API -> service_role)
# Hanya digunakan di backend/scanner, JANGAN ditaruh di frontend!
SUPABASE_KEY=

# Nama tabel hasil scan di Supabase Postgres (opsional, default: scans)
JAGAAWAN_SUPABASE_TABLE=scans
